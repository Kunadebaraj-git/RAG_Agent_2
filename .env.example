# === Backend ===
# Format: postgresql+psycopg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/rag_db?sslmode=require
DATABASE_URL=
JWT_SECRET=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

GROQ_API_KEY=gsk_your_groq_api_key
HF_API_TOKEN=hf_your_huggingface_token

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.3

# HF Embedding
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_DIM=384

# CORS
FRONTEND_URL=http://localhost:5173

# === Frontend ===
VITE_API_URL=http://localhost:8000
